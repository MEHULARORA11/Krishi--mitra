# Copy to server/.env for local API development.
# Keep real secrets out of git; server/.env is git-ignored.

PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini AI
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI grounded explanation layer
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=10000

# WeatherAPI.com (server-side only)
# https://www.weatherapi.com/signup.aspx
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
WEATHER_FORECAST_DAYS=3
WEATHER_REQUEST_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_MINUTES=10
WEATHER_ALERTS_ENABLED=true

# ML model
MODEL_PATH=server/model

# Clerk Auth
# https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Clerk webhook secret
# https://dashboard.clerk.com -> Webhooks
CLERK_WEBHOOK_SECRET=

# Neon PostgreSQL
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Sarvam AI
SARVAM_API_KEY=

# Copernicus Sentinel Hub
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# data.gov.in
DATA_GOV_API_KEY=

# Agromonitoring (OpenWeather Agro API - Satellite NDVI)
# https://agromonitoring.com
AGROMONITORING_API_KEY=
