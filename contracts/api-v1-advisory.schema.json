{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishimitra.local/contracts/api-v1-advisory.schema.json",
  "title": "KrishiMitra API v1 Grounded Advisory Response",
  "type": "object",
  "required": [
    "requestId",
    "analysisId",
    "diagnosis",
    "contextUsed",
    "approvedActions",
    "blockedActions",
    "explanation",
    "missingData",
    "escalation",
    "provenance",
    "dataMode"
  ],
  "additionalProperties": false,
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "analysisId": { "type": "string", "minLength": 1 },
    "diagnosis": {
      "type": "object",
      "required": ["relevance", "crop", "disease", "confidence", "uncertainty", "modelVersion"],
      "additionalProperties": false,
      "properties": {
        "relevance": {
          "type": "string",
          "enum": ["plant", "not_plant", "unclear"]
        },
        "crop": { "type": ["string", "null"] },
        "disease": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "uncertainty": {
          "type": "string",
          "enum": ["accepted", "low_confidence", "unknown", "unsupported_image"]
        },
        "modelVersion": { "type": "string" }
      }
    },
    "contextUsed": {
      "type": "object",
      "required": ["field", "activeCrops", "soil", "weather"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "object",
          "required": ["id", "name", "location"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "location": { "type": "string" }
          }
        },
        "activeCrops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["crop", "stage"],
            "additionalProperties": false,
            "properties": {
              "crop": { "type": "string" },
              "stage": { "type": "string" }
            }
          }
        },
        "soil": {
          "type": "object",
          "required": ["summary", "sourceId"],
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "string" },
            "sourceId": { "type": "string" }
          }
        },
        "weather": {
          "type": "object",
          "required": ["summary", "observedAt", "sourceId", "freshness"],
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "string" },
            "observedAt": { "type": ["string", "null"], "format": "date-time" },
            "sourceId": { "type": "string" },
            "freshness": {
              "type": "string",
              "enum": ["live", "cached", "stale", "fixture", "mock", "unavailable"]
            }
          }
        }
      }
    },
    "approvedActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "blockedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "reasonCodes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "summary",
        "urgency",
        "actionExplanations",
        "avoidedActionExplanations",
        "questions",
        "uncertaintyNotice",
        "escalationNotice"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "urgency": {
          "type": "string",
          "enum": ["routine", "soon", "urgent", "officer_review"]
        },
        "actionExplanations": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionExplanation" }
        },
        "avoidedActionExplanations": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionExplanation" }
        },
        "questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "uncertaintyNotice": { "type": "string" },
        "escalationNotice": { "type": ["string", "null"] }
      }
    },
    "missingData": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalation": {
      "type": "object",
      "required": ["required", "reason"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["ruleVersion", "promptVersion", "schemaVersion", "modelVersion", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "ruleVersion": { "type": "string" },
        "promptVersion": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "modelVersion": { "type": "string" },
        "sourceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dataMode": {
      "type": "object",
      "required": ["ml", "weather", "rules", "llm"],
      "additionalProperties": false,
      "properties": {
        "ml": { "$ref": "#/$defs/dataMode" },
        "weather": { "$ref": "#/$defs/dataMode" },
        "rules": { "$ref": "#/$defs/dataMode" },
        "llm": { "$ref": "#/$defs/dataMode" }
      }
    }
  },
  "$defs": {
    "dataMode": {
      "type": "string",
      "enum": ["live", "cached", "fixture", "mock", "unavailable"]
    },
    "action": {
      "type": "object",
      "required": ["id", "title", "safeText", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "safeText": { "type": "string" },
        "sourceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "actionExplanation": {
      "type": "object",
      "required": ["actionId", "explanation"],
      "additionalProperties": false,
      "properties": {
        "actionId": { "type": "string" },
        "explanation": { "type": "string" }
      }
    }
  }
}
