{
  "name": "krishi-India",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:full": "concurrently -n client,api -c cyan,green \"npm run dev:client\" \"npm run dev:api\"",
    "build": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "verify:phase3": "tsx server/src/scripts/verifyPhase3Contracts.ts",
    "verify:phase5": "tsx server/src/scripts/verifyPhase5Lite.ts",
    "verify:phase6": "tsx server/src/scripts/verifyPhase6EcosystemAdvisory.ts",
    "verify:weather": "tsx server/src/scripts/verifyWeatherFlow.ts",
    "seed:phase4": "tsx server/src/scripts/seedPhase4Demo.ts",
    "verify:phase4": "tsx server/src/scripts/verifyPhase4Rules.ts",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:api": "node server/dist/index.js",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/express": "^2.1.60",
    "@clerk/react": "^6.14.5",
    "@google/generative-ai": "^0.21.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "sharp": "^0.33.5",
    "sonner": "^2.0.8",
    "svix": "^2.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
