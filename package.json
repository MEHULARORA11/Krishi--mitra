    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^5.2.0"
  }
