# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Clerk publishable key — get from https://dashboard.clerk.com → API Keys
# Starts with pk_test_ (dev) or pk_live_ (prod)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Only needed in production when deploying frontend separately from the API.
# In development, Vite proxies API calls automatically — leave this blank.
VITE_API_BASE_URL=

# ─── Backend (server/.env) ──────────────────────────────────────────────────
# These variables belong in server/.env — copy server/env.example to server/.env
